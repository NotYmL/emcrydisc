{
  "manifest_version": 3,
  "name": "VanyEnc Quantum",
  "version": "1.0.0",
  "description": "Post-Quantum Cryptography extension for Discord DMs using Ring-LWE and AES-256-GCM.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://*.discord.com/*", "*://discord.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vany.js"],
      "matches": ["*://*.discord.com/*", "*://discord.com/*"]
    }
  ]
}
